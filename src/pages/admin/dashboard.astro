---
import Layout from '../../layouts/Layout.astro';
import { connectDB } from '../../lib/mongodb';
import { User } from '../../models/User';
import { verifyToken } from '../../lib/auth';

const token = Astro.cookies.get('token')?.value;
if (!token) return Astro.redirect('/login');

const decoded = verifyToken(token) as any;
if (!decoded || decoded.role !== 'admin') return Astro.redirect('/dashboard');

await connectDB();
const adminUser = await (User as any).findById(decoded.userId);
---

<Layout title="Admin - Todos los Futuros Imposibles">
    <header class="bg-slate-900 text-white py-6">
		<div class="max-w-6xl mx-auto px-4 flex justify-between items-center">
			<h1 class="text-2xl font-black font-title flex items-center gap-2">
                <span class="bg-primary text-white px-2 py-0.5 rounded text-xs uppercase tracking-tighter">Admin</span>
                Panel Global FI
            </h1>
            <div class="flex items-center gap-4">
                <span class="text-xs font-bold opacity-60">Hola, {adminUser.name}</span>
			    <a href="/logout" class="text-sm font-bold hover:text-primary transition-colors">Cerrar Sesión</a>
            </div>
		</div>
	</header>

    <main class="max-w-6xl mx-auto px-4 py-12">
        <div class="flex flex-col md:flex-row justify-between items-center gap-6 mb-12">
            <div>
                <h2 class="text-4xl font-black text-slate-900 mb-2">Visión General</h2>
                <p class="text-slate-500">Supervisando el progreso de toda la comunidad.</p>
            </div>
            
            <div class="relative w-full max-w-md">
                <input 
                    type="text" 
                    id="searchInput" 
                    placeholder="Buscar por FI, descripción o usuario..." 
                    class="w-full pl-12 pr-4 py-4 bg-white border border-slate-200 rounded-2xl shadow-sm focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-sm"
                />
                <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
        </div>

        <div id="fisContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Cargando... -->
            <div class="col-span-full py-20 text-center">
                <p class="text-slate-400 font-bold animate-pulse">Cargando Futuros Imposibles...</p>
            </div>
        </div>
    </main>

    <!-- Modal de Detalles -->
    <div id="detailModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-white w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden">
            <div class="bg-slate-900 px-8 py-6 flex justify-between items-start">
                <div>
                    <span class="text-[10px] font-black uppercase tracking-widest text-primary bg-primary/20 px-2 py-0.5 rounded mb-2 inline-block">Futuro Imposible</span>
                    <h3 id="detailTitle" class="text-xl font-black text-white leading-tight"></h3>
                </div>
                <button id="closeDetail" class="text-slate-400 hover:text-white transition-colors ml-4 mt-1 flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="px-8 py-6 space-y-6">
                <!-- Usuario -->
                <div class="flex items-center gap-3">
                    <div id="detailAvatar" class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center font-black text-primary text-sm flex-shrink-0"></div>
                    <div>
                        <p id="detailUserName" class="text-sm font-black text-slate-900"></p>
                        <p id="detailUserEmail" class="text-xs text-slate-400 font-bold"></p>
                    </div>
                </div>

                <!-- Descripción -->
                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Descripción</p>
                    <p id="detailDescription" class="text-sm text-slate-600 leading-relaxed"></p>
                </div>

                <!-- Progreso -->
                <div>
                    <div class="flex justify-between text-[10px] font-black mb-2">
                        <span class="text-slate-400 uppercase tracking-wider">Progreso</span>
                        <span id="detailPercentageText" class="text-primary"></span>
                    </div>
                    <div class="w-full h-3 bg-slate-100 rounded-full overflow-hidden">
                        <div id="detailProgressBar" class="h-full bg-primary transition-all duration-700 rounded-full"></div>
                    </div>
                </div>

                <!-- Fechas -->
                <div class="grid grid-cols-2 gap-4 pt-2 border-t border-slate-100">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Creado</p>
                        <p id="detailCreatedAt" class="text-sm font-bold text-slate-700"></p>
                    </div>
                    <div id="detailTargetContainer">
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Fecha Objetivo</p>
                        <p id="detailTargetDate" class="text-sm font-bold text-slate-700"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script is:inline>
    const container = document.getElementById('fisContainer');
    const searchInput = document.getElementById('searchInput');
    var currentFisList = [];

    async function fetchFis(query) {
        query = query || '';
        try {
            var res = await fetch('/api/admin/fis?q=' + encodeURIComponent(query));
            if (!res.ok) throw new Error();
            var fis = await res.json();
            renderFis(fis);
        } catch (err) {
            container.innerHTML = '<div class="col-span-full text-red-500 font-bold text-center">Error al cargar datos</div>';
        }
    }

    function escapeHtml(text) {
        if (!text) return '';
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function renderFis(fis) {
        currentFisList = fis || [];
        if (currentFisList.length === 0) {
            container.innerHTML = '<div class="col-span-full py-20 text-center bg-white rounded-3xl border border-dashed border-slate-200 text-slate-400">No se encontraron resultados</div>';
            return;
        }

        // Agrupar por usuario
        var grouped = {};
        for (var i = 0; i < currentFisList.length; i++) {
            var fi = currentFisList[i];
            var userId = (fi.user && fi.user._id) || 'unknown';
            if (!grouped[userId]) {
                grouped[userId] = {
                    user: fi.user || { name: 'Usuario Desconocido', email: '' },
                    fis: []
                };
            }
            grouped[userId].fis.push({ data: fi, index: i });
        }

        var html = '';
        for (var userId in grouped) {
            var group = grouped[userId];
            var user = group.user;
            var userFis = group.fis;
            var userName = user.name || 'Usuario';
            var userEmail = user.email || '';

            html += '<div class="col-span-full bg-white rounded-[2rem] p-8 border border-slate-100 shadow-xl shadow-slate-200/40 mb-12 last:mb-0 relative overflow-hidden">' +
                '<div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-bl-full -mr-32 -mt-32 -z-0"></div>' +
                '<div class="relative z-10">' +
                    '<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 pb-8 border-b border-slate-50">' +
                        '<div class="flex items-center gap-5">' +
                            '<div class="w-16 h-16 rounded-2xl bg-slate-900 flex items-center justify-center font-black text-white text-2xl shadow-lg">' + 
                                escapeHtml(userName.charAt(0).toUpperCase()) + 
                            '</div>' +
                            '<div>' +
                                '<h3 class="text-2xl font-black text-slate-900 leading-tight">' + escapeHtml(userName) + '</h3>' +
                                '<p class="text-xs text-slate-400 font-bold uppercase tracking-widest">' + escapeHtml(userEmail) + '</p>' +
                            '</div>' +
                        '</div>' +
                        '<div class="flex items-center gap-2">' +
                             '<div class="bg-primary/10 text-primary px-4 py-2 rounded-xl text-xs font-black uppercase tracking-widest border border-primary/10">' + 
                                userFis.length + ' ' + (userFis.length === 1 ? 'FI' : 'FIs') + 
                             '</div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">';
            
            for (var j = 0; j < userFis.length; j++) {
                var fiItem = userFis[j];
                var fi = fiItem.data;
                var idx = fiItem.index;

                html += '<div class="bg-slate-50/50 rounded-2xl p-6 border border-slate-100 hover:border-primary/30 hover:bg-white hover:shadow-lg transition-all group relative flex flex-col h-full">' +
                    '<h4 class="text-base font-black text-slate-900 mb-4 leading-tight line-clamp-2 min-h-[3rem]">' + escapeHtml(fi.title) + '</h4>' +
                    '<div class="mb-6 mt-auto">' +
                        '<div class="flex justify-between text-[10px] font-black mb-2">' +
                            '<span class="text-slate-400 uppercase tracking-widest">Progreso</span>' +
                            '<span class="text-primary">' + (fi.percentage || 0) + '%</span>' +
                        '</div>' +
                        '<div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden">' +
                            '<div class="h-full bg-primary transition-all duration-1000" style="width:' + (fi.percentage || 0) + '%"></div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="pt-4 border-t border-slate-100 flex justify-between items-center mt-auto">' +
                        '<span class="text-[10px] text-slate-400 font-bold">' + (fi.createdAt ? new Date(fi.createdAt).toLocaleDateString() : '') + '</span>' +
                        '<button type="button" class="ver-detalles text-[10px] font-black text-primary hover:underline uppercase tracking-widest flex items-center gap-1" data-fi-index="' + idx + '">' +
                            'Ver Detalles' +
                            '<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>' +
                        '</button>' +
                    '</div>' +
                '</div>';
            }
            
            html += '</div></div></div>';
        }
        container.innerHTML = html;
    }

    var timeout;
    searchInput.oninput = function() {
        clearTimeout(timeout);
        timeout = setTimeout(function() { fetchFis(searchInput.value); }, 300);
    };

    var detailModal = document.getElementById('detailModal');
    var closeDetail = document.getElementById('closeDetail');

    container.addEventListener('click', function(e) {
        var btn = e.target && e.target.closest && e.target.closest('.ver-detalles');
        if (!btn) return;
        var idx = btn.getAttribute('data-fi-index');
        if (idx === null || idx === '') return;
        var fi = currentFisList[parseInt(idx, 10)];
        if (!fi) return;

        var user = fi.user || {};
        var userName = user.name || 'Usuario';
        var userEmail = user.email || '';

        document.getElementById('detailTitle').textContent = fi.title || '';
        document.getElementById('detailAvatar').textContent = (userName.charAt(0) || '?').toUpperCase();
        document.getElementById('detailUserName').textContent = userName;
        document.getElementById('detailUserEmail').textContent = userEmail;
        document.getElementById('detailDescription').textContent = fi.description || 'Sin descripción.';
        document.getElementById('detailPercentageText').textContent = (fi.percentage || 0) + '%';
        document.getElementById('detailProgressBar').style.width = (fi.percentage || 0) + '%';
        document.getElementById('detailCreatedAt').textContent = fi.createdAt ? new Date(fi.createdAt).toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }) : '';

        var targetContainer = document.getElementById('detailTargetContainer');
        if (fi.targetDate) {
            document.getElementById('detailTargetDate').textContent = new Date(fi.targetDate).toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' });
            targetContainer.classList.remove('hidden');
        } else {
            targetContainer.classList.add('hidden');
        }
        detailModal.classList.remove('hidden');
    });

    if (closeDetail) closeDetail.addEventListener('click', function() { detailModal.classList.add('hidden'); });
    if (detailModal) detailModal.addEventListener('click', function(e) { if (e.target === detailModal) detailModal.classList.add('hidden'); });

    fetchFis();
</script>
