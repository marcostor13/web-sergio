---
const title = "Sergio Nolasco - Emprender Sin Capital";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-50 text-slate-900 font-sans">
		<main class="min-h-screen flex flex-col items-center justify-center p-4">
			<h1 class="text-5xl font-black text-center mb-6">
				Sergio Nolasco
			</h1>
			<p class="text-xl text-slate-600 text-center max-w-2xl">
				Ayudando a las personas a emprender sin capital y hacer crecer sus negocios.
			</p>
			<div class="mt-10 flex gap-4">
				<a href="/login" class="px-6 py-3 bg-slate-900 text-white font-bold rounded-xl hover:bg-slate-800 transition-colors">
					Iniciar Sesión
				</a>
				<a href="/register" class="px-6 py-3 bg-[#76B82A] text-white font-bold rounded-xl hover:bg-[#009E39] transition-colors">
					Registrarse
				</a>
			</div>
		</main>
	</body>
</html>
